# Public site URL — used for canonical URLs, sitemap, and Open Graph.
# Set this in Vercel: Project → Settings → Environment Variables
# Apply to Production, Preview, and Development.
NEXT_PUBLIC_SITE_URL=https://www.resetgoals.com

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Microsoft Clarity project ID (from clarity.microsoft.com → Setup)
# NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Loops.so newsletter (recommended) — server-only, never expose client-side
# LOOPS_API_KEY=
# Optional: auto-add signups to this mailing list (find ID in Loops → Mailing Lists)
# LOOPS_MAILING_LIST_ID=

# Optional: generic webhook instead of Loops API (Zapier, etc.)
# NEWSLETTER_WEBHOOK_URL=

# VERCEL_URL is injected automatically by Vercel at build/runtime.
# You do not need to set it. Used as fallback when NEXT_PUBLIC_SITE_URL is unset.
